{
  "name": "stream-production",
  "version": "1.0.0",
  "description": "Live stream production rundown manager for card game tournaments",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon --ignore data/ --ignore public/ server/index.js",
    "tunnel": "dotenv -- cloudflared tunnel run",
    "dev:tunnel": "concurrently \"npm run dev\" \"npm run tunnel\"",
    "package": "pkg . --targets node18-win-x64 --output dist/stream-production.exe"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lowdb": "^1.0.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "cloudflared": "^0.7.3",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "nodemon": "^3.1.14",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "data/**/*"
    ],
    "scripts": [
      "server/**/*.js"
    ]
  }
}
